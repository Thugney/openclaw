# MSClaw environment configuration
# Copy to .env and fill in values

# ---------------------------------------------------------------------------
# Infrastructure (defaults work with docker-compose)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://msclaw:msclaw@localhost:5432/msclaw
NATS_URL=nats://localhost:4222
OPA_URL=http://localhost:8181
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=msclaw
MINIO_SECRET_KEY=msclaw123
MINIO_BUCKET=msclaw-artifacts

# ---------------------------------------------------------------------------
# Microsoft adapter mode: "mock" or "real"
# ---------------------------------------------------------------------------
MS_MODE=mock

# Required only for MS_MODE=real:
# MS_TENANT_ID=your-entra-tenant-id
# MS_CLIENT_ID=your-app-client-id
# MS_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
CONTROL_API_PORT=8080
UI_PORT=3000
LOG_LEVEL=INFO

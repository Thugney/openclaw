FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi>=0.109 uvicorn[standard]>=0.27 asyncpg>=0.29 \
    nats-py>=2.6 httpx>=0.27 pydantic>=2.5 python-ulid>=2.2 \
    miniopy-async>=1.19 msal>=1.26

COPY shared /shared
RUN pip install --no-cache-dir /shared

COPY plugins /plugins

EXPOSE 8003

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003", "--reload"]

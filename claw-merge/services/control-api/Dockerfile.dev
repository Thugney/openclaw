FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi>=0.109 uvicorn[standard]>=0.27 asyncpg>=0.29 \
    nats-py>=2.6 pydantic>=2.5 python-ulid>=2.2 \
    python-jose[cryptography]>=3.3 passlib[bcrypt]>=1.7 httpx>=0.27

COPY shared /shared
RUN pip install --no-cache-dir /shared

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
